# NexusSaaS environment. Copy to .env.
ENV=development
SECRET_KEY=                          # >= 32 random chars, required in production
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# App role (no superuser, no BYPASSRLS) and owner role for migrations
DATABASE_URL=postgresql+psycopg2://nexus_app:nexus_app@localhost:5432/nexussaas
MIGRATION_DATABASE_URL=postgresql+psycopg2://nexussaas:nexussaas@localhost:5432/nexussaas
APP_DB_PASSWORD=nexus_app
REDIS_URL=redis://localhost:6379/0

# Google OIDC (Authorization Code + PKCE)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# Object storage: local | s3
STORAGE_BACKEND=local
S3_BUCKET=nexussaas-artifacts
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Sandbox
SANDBOX_IMAGE=nexussaas-sandbox:latest
SANDBOX_RUNTIME=                     # runsc for gVisor
SANDBOX_TIMEOUT=120

# Limits / pilot
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
JOB_MAX_ATTEMPTS=3
PILOT_MODE=false
PILOT_ALLOWED_EMAILS=

# NexusSaaS environment. Copy to .env.
ENV=development
SECRET_KEY="<your-32-char-random-string>" # >= 32 random chars, required in production
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# App role (no superuser, no BYPASSRLS) and owner role for migrations
DATABASE_URL=postgresql+psycopg2://nexus_app:nexus_app@localhost:5432/nexussaas
MIGRATION_DATABASE_URL=postgresql+psycopg2://nexussaas:nexussaas@localhost:5432/nexussaas
APP_DB_PASSWORD=nexus_app
REDIS_URL=redis://localhost:6379/0

# Google OIDC (Authorization Code + PKCE)
# You need to register your application with Google and obtain these credentials.
# Set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET from your Google Cloud project.
GOOGLE_CLIENT_ID="<your-google-client-id>"
GOOGLE_CLIENT_SECRET="<your-google-client-secret>"
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Stripe
# STRIPE_SECRET_KEY is your secret key (sk_live_...) for live mode or (sk_test_...) for test mode.
# STRIPE_WEBHOOK_SECRET is the signing secret for verifying webhook events.
# Get it from the Stripe Dashboard -> Developers -> Webhooks after setting up a webhook endpoint.
STRIPE_SECRET_KEY="<your-stripe-secret-key>"
STRIPE_WEBHOOK_SECRET="<your-stripe-webhook-secret>"
STRIPE_PRICE_PRO="<your-stripe-price-id-for-pro-plan>"

# Object storage: local | s3
STORAGE_BACKEND=local
S3_BUCKET=nexussaas-artifacts
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Sandbox
SANDBOX_IMAGE=nexussaas-sandbox:latest
SANDBOX_RUNTIME=                     # runsc for gVisor
SANDBOX_TIMEOUT=120

# Limits / pilot
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
JOB_MAX_ATTEMPTS=3
PILOT_MODE=false
PILOT_ALLOWED_EMAILS=

# Outbound mail (e-mail verification): console (dev, prints the link) | smtp | recording (tests)
MAIL_BACKEND=console
MAIL_FROM=NexusSaaS <support@example.com> # Change to your verified sending address
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
EMAIL_VERIFY_HOURS=24

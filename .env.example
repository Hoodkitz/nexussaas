# NexusSaaS Environment Variables
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql+psycopg2://nexussaas:nexussaas@localhost:5432/nexussaas

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change-me-in-production
GOOGLE_CLIENT_ID=489531653410-iIt5femvSudnjopqmShu94j03cn4087m.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<create via Google Console: console.cloud.google.com/auth/clients>
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Stripe
STRIPE_SECRET_KEY=<from Stripe Dashboard: dashboard.stripe.com/apikeys>
STRIPE_WEBHOOK_SECRET=<from Stripe Dashboard: dashboard.stripe.com/webhooks>

# Object Storage
S3_BUCKET=nexussaas-artifacts
S3_ENDPOINT=http://localhost:9000

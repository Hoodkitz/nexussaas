[Unit]
Description=NexusSaaS API (dev)
After=network-online.target docker.service

[Service]
WorkingDirectory=%h/nexussaas
ExecStart=%h/nexussaas/.venv/bin/uvicorn apps.api.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target

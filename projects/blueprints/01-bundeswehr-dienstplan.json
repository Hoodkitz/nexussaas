{"name": "bundeswehr-dienstplan", "version": "0.1", "description": "Dienstplan-SaaS: Soldaten, Schichten, Dienstpläne mit Freigabe, Tauschanfragen, Arbeitszeitkonten (SAZV)",
 "entities": [
  {"name": "Soldat", "fields": [{"name": "personalnummer", "type": "text", "required": true, "unique": true}, {"name": "name", "type": "text", "required": true}, {"name": "dienstgrad", "type": "text"}, {"name": "qualifikationen", "type": "json"}, {"name": "email", "type": "email"}]},
  {"name": "Dienstposten", "fields": [{"name": "bezeichnung", "type": "text", "required": true}, {"name": "benoetigte_qualifikation", "type": "text"}, {"name": "beginn", "type": "timestamp", "required": true}, {"name": "ende", "type": "timestamp", "required": true}, {"name": "anrechnungsfaktor", "type": "float"}]},
  {"name": "Dienstplan", "fields": [{"name": "zeitraum_von", "type": "date", "required": true}, {"name": "zeitraum_bis", "type": "date", "required": true}, {"name": "status", "type": "text", "required": true}, {"name": "einsatzmodus", "type": "boolean"}, {"name": "freigegeben_am", "type": "timestamp"}]},
  {"name": "Schicht", "fields": [{"name": "dienstplan_id", "type": "ref:Dienstplan", "required": true}, {"name": "dienstposten_id", "type": "ref:Dienstposten", "required": true}, {"name": "soldat_id", "type": "ref:Soldat"}, {"name": "fixiert", "type": "boolean"}]},
  {"name": "Tauschanfrage", "fields": [{"name": "schicht_id", "type": "ref:Schicht", "required": true}, {"name": "von_soldat_id", "type": "ref:Soldat", "required": true}, {"name": "an_soldat_id", "type": "ref:Soldat", "required": true}, {"name": "status", "type": "text", "required": true}, {"name": "begruendung", "type": "text", "max_length": 500}]},
  {"name": "Arbeitszeitkonto", "fields": [{"name": "soldat_id", "type": "ref:Soldat", "required": true}, {"name": "monat", "type": "date", "required": true}, {"name": "stunden", "type": "float"}, {"name": "mehrarbeit", "type": "float"}, {"name": "bereitschaft", "type": "float"}, {"name": "freizeitausgleich", "type": "float"}]}
 ]}
